{
  "name": "letterpress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "letterpress": "bin/letterpress.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "prettier --check . && tsc -p . && vitest run",
    "build": "esbuild client/main.ts --bundle --format=esm --outfile=dist/client/main.js && cp client/index.html dist/client/index.html",
    "mutate": "stryker run"
  },
  "dependencies": {
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "licensee": "^12.0.2",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
