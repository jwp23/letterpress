{
  "name": "letterpress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "letterpress": "bin/letterpress.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "prettier --check . && tsc -p . && vitest run",
    "build": "esbuild client/main.ts --bundle --format=esm --outfile=dist/client/main.js && cp client/index.html dist/client/index.html"
  },
  "dependencies": {
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "licensee": "^12.0.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
